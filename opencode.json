{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "environment": {
        "BROWSER": "chromium"
      }
    },
    "cressida": {
      "type": "local",
      "command": ["C:/Program Files/Python311/python.exe", "-m", "cressida.mcp_server"],
      "enabled": true
    }
  }
}
